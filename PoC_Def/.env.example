# Copiar a .env.local y rellenar. Lo único imprescindible es el bloque de IA.

# IA
LLM_PROVEEDOR=helmcode
HELMCODE_API_KEY=
LLM_MODELO_RAZONAMIENTO=
LLM_MODELO_RAPIDO=
LLM_MODELO_VISION=

# Embeddings (512 dimensiones, como el esquema de la base)
EMBEDDINGS_PROVEEDOR=helmcode
EMBEDDINGS_MODELO=
EMBEDDINGS_DIMENSIONES=512

# Base de datos
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PERSISTIR=

# SMS y 112 por voz (HappyRobot)
HAPPYROBOT_API_KEY=
HAPPYROBOT_API_BASE=https://platform.eu.happyrobot.ai
HAPPYROBOT_ENVIRONMENT=production
HAPPYROBOT_WEBHOOK_SECRET=
HAPPYROBOT_WORKFLOW_SLUG_SMS=
HAPPYROBOT_WORKFLOW_SLUG_ENTRANTE=
HAPPYROBOT_NUMERO_ENTRANTE=
TELEFONO_AVISOS_SMS=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_CHAT_ID_DEMO=

# Fuentes de detección y meteorología
FIRMS_MAP_KEY=
AEMET_API_KEY=
EXA_API_KEY=

# Mundo
ACELERACION_TIEMPO=12
TICK_MS=5000
CAMARAS_INTERVALO_SEG=20

# Marca y dominio público (en local lo escribe el túnel)
ORGANISMO_NOMBRE=
PUBLIC_BASE_URL=
